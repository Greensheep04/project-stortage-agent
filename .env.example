# project-pi-market 环境配置（复制为 .env 后填写；.env 禁止入库）

# 向量链：阿里云百炼 DashScope OpenAI 兼容模式（embedding 专用，勿与生成链混用）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# 重排链：DashScope 原生 rerank 端点（可选；不填用代码默认值）
RERANK_MODEL=qwen3-rerank
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# 生成链：DeepSeek 官方（OpenAI 兼容，独立 Key 与地址）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GENERATION_MODEL=deepseek-flash

# 项目内 PostgreSQL（conda 环境，数据目录 .local/pgdata）
PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=pi_market
# 隔离测试库（同一 PostgreSQL 服务；pytest 只在此库执行破坏性操作）
PGDATABASE_TEST=pi_market_test
PGUSER=pi_admin
# 调查只读角色（仅 SELECT，default_transaction_read_only=on）
PGREADER_USER=pi_reader
